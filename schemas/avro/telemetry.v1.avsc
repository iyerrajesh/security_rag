{
  "type": "record",
  "name": "TelemetryEvent",
  "namespace": "av.fleet",
  "doc": "Vehicle telemetry (topic: vehicle.telemetry). Schema version 1.",
  "fields": [
    {
      "name": "schema_version",
      "type": "int",
      "doc": "Schema version of this event type",
      "default": 1
    },
    {
      "name": "event_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Unique id used for deduplication"
    },
    {
      "name": "vehicle_id",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Event time (timezone-aware, normalized to UTC)"
    },
    {
      "name": "event_type",
      "type": "string",
      "default": "telemetry"
    },
    {
      "name": "speed",
      "type": "double",
      "doc": "Speed in m/s"
    },
    {
      "name": "acceleration",
      "type": "double",
      "doc": "Longitudinal acceleration in m/s^2 (negative = decelerating)"
    },
    {
      "name": "braking",
      "type": "double",
      "doc": "Brake pressure, 0 (none) to 1 (full)"
    },
    {
      "name": "steering",
      "type": "double",
      "doc": "Steering wheel angle in degrees (negative = left)"
    },
    {
      "name": "battery",
      "type": "double",
      "doc": "Battery state of charge, percent"
    },
    {
      "name": "gps_lat",
      "type": "double"
    },
    {
      "name": "gps_lon",
      "type": "double"
    }
  ]
}
